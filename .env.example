# ========================================================
# Root Environment Template (Copy to backend/.env and frontend/.env)
# ========================================================

# Backend Configuration
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# MongoDB Atlas or Local Connection
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=inventory_forecasting

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# Frontend Configuration (Used in frontend/.env)
VITE_API_BASE_URL=http://localhost:8000
